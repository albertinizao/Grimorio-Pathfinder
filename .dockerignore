.git
.gitignore
.codex
.codex-remote-attachments
.agents
.atl

target
frontend/node_modules
frontend/dist
frontend/.vite
frontend/*.tsbuildinfo

# Keep only the canonical runtime dataset and initial overrides in the image.
data/raw
data/local
data/generated/*.tsv
!data/generated/spells-es.generated.json
!data/overrides/spells-es.overrides.json

# Local credentials and machine-specific configuration must never enter the
# build context or image.
.env
.env.*
!.env.example
src/main/resources/application-local.properties

*.log
hs_err_pid*
replay_pid*
